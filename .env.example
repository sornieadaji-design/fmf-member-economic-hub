# --- Database ---
# Local: postgres running with a database named fmf. Vercel/Neon: paste the pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fmf"

# --- NextAuth.js v5 (Auth.js) ---
# Generate: `npx auth secret`  (or `openssl rand -base64 32`)
AUTH_SECRET="replace-me"
# Google OAuth credentials (Google Cloud Console -> Credentials -> OAuth client ID, Web application)
AUTH_GOOGLE_ID="replace-me"
AUTH_GOOGLE_SECRET="replace-me"
# In production set to your canonical URL, e.g. https://fmf-economic-hub.com.ng
# AUTH_URL="http://localhost:3000"
# On Vercel behind a custom domain, also set:
# AUTH_TRUST_HOST="true"

# --- SEO: canonical public site URL (used for metadata, Open Graph, sitemap, robots) ---
# NEXT_PUBLIC_SITE_URL="https://your-domain"

# --- File storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="replace-me"

# --- Email (transactional; e.g. Resend) — optional in MVP dev ---
# RESEND_API_KEY="replace-me"
# EMAIL_FROM="FMF Hub <no-reply@fmf.example>"

# --- Scheduled reminders cron secret (set in production; Vercel Cron sends it as a Bearer token) ---
# CRON_SECRET="generate-with-openssl-rand-hex-24"

# --- Migration/DB owner role (used to REVOKE update/delete on audit_logs from the app role) ---
# APP_DB_ROLE="fmf_app"
